{
  "name": "sori",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/worker"
  ],
  "scripts": {
    "dev": "npm -w apps/web run dev",
    "dev:worker": "npm -w apps/worker run dev",
    "build": "npm -w apps/web run build",
    "test": "npm run test:deploy && npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "android:apk": "node scripts/android-build.mjs",
    "android:release": "node scripts/android-build.mjs --release",
    "test:e2e": "npm -w apps/web run test:e2e",
    "deploy": "node scripts/deploy.mjs",
    "test:deploy": "node --test scripts/verify-deployment.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "~4.1.12"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261019.1": true
  }
}
